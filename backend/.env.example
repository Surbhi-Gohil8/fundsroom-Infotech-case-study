# Application Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/database_name?schema=public

# JWT Security Configuration
JWT_SECRET=supersecretjwtkeythatisreallylongandsecure12345
JWT_EXPIRES_IN=7d

# AWS S3 Configuration (Optional, fallback to local uploads if values are empty)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
